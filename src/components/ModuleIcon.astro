---
import type { ModuleKey } from '../config/site';

interface Props {
  name: ModuleKey;
  size?: number;
}
const { name, size = 44 } = Astro.props;
---

<svg class="module-icon" viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
  {
    name === 'carta' && (
      <>
        <rect x="6" y="6" width="14" height="14" rx="2.5" />
        <rect x="28" y="6" width="14" height="14" rx="2.5" />
        <rect x="6" y="28" width="14" height="14" rx="2.5" />
        <path d="M11 11h4v4h-4zM33 11h4v4h-4zM11 33h4v4h-4z" fill="currentColor" stroke="none" />
        <path d="M28 28h5v5M42 28v5M37 42h5M28 38v4h4M37 33h-4v5h4v-5" />
      </>
    )
  }
  {
    name === 'reservas' && (
      <>
        <rect x="6" y="9" width="36" height="33" rx="5" />
        <path d="M6 19h36M15 5v8M33 5v8" />
        <path d="M17 30l5 5 9-10" />
      </>
    )
  }
  {
    name === 'web' && (
      <>
        <rect x="5" y="8" width="38" height="32" rx="5" />
        <path d="M5 17h38" />
        <circle cx="11" cy="12.5" r="1.3" fill="currentColor" stroke="none" />
        <circle cx="16" cy="12.5" r="1.3" fill="currentColor" stroke="none" />
        <path d="M24 23c-3.6 0-6.5 2.8-6.5 6.3 0 4.6 6.5 8.7 6.5 8.7s6.5-4.1 6.5-8.7c0-3.5-2.9-6.3-6.5-6.3z" />
        <circle cx="24" cy="29.2" r="2" />
      </>
    )
  }
</svg>
