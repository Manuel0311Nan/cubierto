---
import { getLocale, t } from '../i18n';

const tr = t(getLocale(Astro)).process;
const steps = tr.steps;
---

<section class="section" id="como-empezamos" aria-labelledby="proceso-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="proceso-title">{tr.title}</h2>
      <p>{tr.intro}</p>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    counter-reset: step;
  }
  li {
    position: relative;
    padding-top: var(--space-3);
  }
  li::before {
    content: '';
    position: absolute;
    top: 1.35rem;
    left: 3.2rem;
    right: calc(-1 * var(--space-3));
    height: 2px;
    background: var(--line);
  }
  li:last-child::before {
    display: none;
  }
  .n {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 50%;
    background: var(--saffron);
    color: var(--saffron-ink);
    font-weight: 750;
    font-size: var(--step-1);
  }
  h3 {
    margin-top: var(--space-4);
    font-size: var(--step-2);
  }
  p {
    margin-top: 0.6rem;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    li {
      padding: 0 0 0 4rem;
    }
    li::before {
      top: 3.2rem;
      bottom: calc(-1 * var(--space-4) + 0.4rem);
      left: 1.3rem;
      right: auto;
      width: 2px;
      height: auto;
    }
    h3 {
      margin-top: 0.35rem;
    }
  }
</style>
