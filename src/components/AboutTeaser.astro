---
import Avatar from './Avatar.astro';
import { person } from '../data/about';
---

<section class="section about" aria-labelledby="about-title">
  <div class="wrap grid">
    <Avatar size="9rem" />
    <div>
      <h2 id="about-title">Quién está detrás</h2>
      <p class="lead">{person.intro}</p>
      <p class="promise">{person.promise}</p>
      <a class="btn btn-ghost" href="/sobre-mi/">Más sobre mí</a>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--tile);
  }
  .grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  h2 {
    font-size: var(--step-4);
  }
  .lead {
    margin-top: var(--space-2);
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 40rem;
  }
  .promise {
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
    max-width: 40rem;
    font-weight: 600;
  }
  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
