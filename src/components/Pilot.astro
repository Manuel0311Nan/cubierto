---
import { site, pricing } from '../config/site';
import { getLocale, path, money, t } from '../i18n';

const { pilot } = site;
const locale = getLocale(Astro);
const p = t(locale).pilot;
---

{
  pilot.enabled && (
    <section class="pilot-wrap" aria-labelledby="piloto-title">
      <div class="wrap">
        <div class="pilot">
          <div>
            <h2 id="piloto-title">{p.title(pilot.spots, site.city)}</h2>
            <p>
              {p.intro}
            </p>
            <ul>
              <li>{p.firstMonth(money(pilot.firstMonth, locale), money(pricing.packSetup, locale))}</li>
              <li>{p.after(money(pricing.pack, locale))}</li>
              <li>{p.feedback}</li>
              <li>{p.inPerson}</li>
            </ul>
          </div>
          <a class="btn btn-primary" href={`${path('contacto', locale)}?motivo=piloto`} data-umami-event="pedir-demo" data-umami-event-lugar="piloto">{p.cta}</a>
        </div>
      </div>
    </section>
  )
}

<style>
  .pilot-wrap {
    padding-block: 0 var(--space-6);
  }
  .pilot {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    align-items: end;
    padding: var(--space-4);
    border-radius: var(--radius-l);
    border: 3px solid var(--saffron);
    background: color-mix(in srgb, var(--saffron) 10%, var(--paper));
  }
  h2 {
    font-size: var(--step-3);
  }
  p {
    margin-top: var(--space-2);
    max-width: 40rem;
  }
  ul {
    margin: var(--space-2) 0 0;
    padding-left: 1.2rem;
  }
  li + li {
    margin-top: 0.3rem;
  }
  @media (max-width: 760px) {
    .pilot {
      grid-template-columns: 1fr;
      padding: var(--space-3);
    }
  }
</style>
