---
import Logo from './Logo.astro';
import { site, nav } from '../config/site';
import { consentRequired } from '../config/cookies';
import { getLocale, path, t } from '../i18n';

const locale = getLocale(Astro);
const tr = t(locale);
const f = tr.footer;
const items = nav.map((key) => ({ href: path(key, locale), label: tr.nav[key] }));

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap grid">
    <div class="brand">
      <Logo tone="light" />
      <p>{f.from(tr.meta.tagline, site.city)}</p>
      <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
      {site.contact.phone && <p><a href={`tel:${site.contact.phone}`} data-umami-event="llamar">{site.contact.phoneDisplay}</a></p>}
    </div>

    <nav aria-label={f.services}>
      <h2>{f.services}</h2>
      <ul>
        {items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        {locale === 'es' && <li><a href={path('guias', locale)}>{f.guides}</a></li>}
        <li><a href={path('herramientas', locale)}>{f.tools}</a></li>
        <li><a href={path('contacto', locale)}>{f.contact}</a></li>
      </ul>
    </nav>

    <nav aria-label={f.legal}>
      <h2>{f.legal}</h2>
      <ul>
        <li><a href={path('avisoLegal', locale)} hreflang={locale === 'es' ? undefined : 'es'}>{f.legalNotice}{tr.common.inSpanish}</a></li>
        <li><a href={path('privacidad', locale)} hreflang={locale === 'es' ? undefined : 'es'}>{f.privacy}{tr.common.inSpanish}</a></li>
        <li><a href={path('cookies', locale)} hreflang={locale === 'es' ? undefined : 'es'}>{f.cookies}{tr.common.inSpanish}</a></li>
        {consentRequired && <li><button type="button" class="linklike" data-open-consent>{f.cookieSettings}</button></li>}
      </ul>
    </nav>
  </div>
  <div class="wrap base">
    <p>{f.madeIn(year, site.name)}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bottle);
    color: var(--bottle-ink);
    padding-block: var(--space-5) var(--space-3);
    --line: color-mix(in srgb, var(--bottle-ink) 22%, transparent);
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-4);
  }
  .brand p {
    margin-top: 0.6rem;
    max-width: 22rem;
    opacity: 0.85;
  }
  h2 {
    font-size: var(--step-0);
    margin-bottom: 0.6rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  a {
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }
  a:hover {
    text-decoration-color: var(--saffron);
  }
  .linklike {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    cursor: pointer;
  }
  .linklike:hover {
    text-decoration-color: var(--saffron);
  }
  .base {
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    opacity: 0.8;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
