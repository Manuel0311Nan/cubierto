---
import Logo from './Logo.astro';
import { site, nav } from '../config/site';
import { consentRequired } from '../config/cookies';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap grid">
    <div class="brand">
      <Logo tone="light" />
      <p>{site.tagline}. Desde {site.city}.</p>
      <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
      {site.contact.phone && <p><a href={`tel:${site.contact.phone}`} data-umami-event="llamar">{site.contact.phoneDisplay}</a></p>}
    </div>

    <nav aria-label="Servicios">
      <h2>Servicios</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/guias/">Guías</a></li>
        <li><a href="/contacto/">Contacto</a></li>
      </ul>
    </nav>

    <nav aria-label="Legal">
      <h2>Legal</h2>
      <ul>
        <li><a href="/aviso-legal/">Aviso legal</a></li>
        <li><a href="/privacidad/">Privacidad</a></li>
        <li><a href="/cookies/">Cookies</a></li>
        {consentRequired && <li><button type="button" class="linklike" data-open-consent>Configurar cookies</button></li>}
      </ul>
    </nav>
  </div>
  <div class="wrap base">
    <p>© {year} {site.name}. Hecho y alojado en Europa.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bottle);
    color: var(--bottle-ink);
    padding-block: var(--space-5) var(--space-3);
    --line: color-mix(in srgb, var(--bottle-ink) 22%, transparent);
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-4);
  }
  .brand p {
    margin-top: 0.6rem;
    max-width: 22rem;
    opacity: 0.85;
  }
  h2 {
    font-size: var(--step-0);
    margin-bottom: 0.6rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  a {
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }
  a:hover {
    text-decoration-color: var(--saffron);
  }
  .linklike {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    cursor: pointer;
  }
  .linklike:hover {
    text-decoration-color: var(--saffron);
  }
  .base {
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    opacity: 0.8;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
