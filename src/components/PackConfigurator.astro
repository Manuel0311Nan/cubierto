---
import { getModules } from '../data/modules';
import { pricing } from '../config/site';
import { getLocale, localeInfo, path, money, fill, t } from '../i18n';

const locale = getLocale(Astro);
const tr = t(locale);
const p = tr.pack;
const modules = getModules(locale);
const sum = Object.values(pricing.monthly).reduce((a, b) => a + b, 0);
const data = JSON.stringify({ monthly: pricing.monthly, pack: pricing.pack, setup: pricing.webSetup, packSetup: pricing.packSetup });
// Textos para el script, con huecos {amount}.
const text = JSON.stringify({
  intl: localeInfo[locale].intl,
  savings: p.savings,
  setupPack: p.setupPack,
  setupWeb: p.setupWeb,
  none: p.none,
  addMissing: p.addMissing,
  addMore: p.addMore,
});
---

<section class="pricing" id="precios" aria-labelledby="precios-title">
  <div class="wrap inner">
    <div class="copy">
      <h2 id="precios-title">{p.title}</h2>
      <p>{p.intro(money(pricing.pack, locale), money(sum, locale))}</p>
      <p class="note">{tr.common.vatNote}</p>
    </div>

    <form class="calc" data-calc={data} data-text={text} action={path('contacto', locale)} method="get">
      <fieldset>
        <legend class="visually-hidden">{p.legend}</legend>
        {
          modules.map((m) => (
            <label class="opt">
              <input type="checkbox" name="plan" value={m.key} checked />
              <span class="box" aria-hidden="true" />
              <span class="opt-name">{m.name}</span>
              <span class="opt-price">{money(pricing.monthly[m.key], locale)}{tr.common.perMonthShort}</span>
            </label>
          ))
        }
      </fieldset>

      <div class="result" aria-live="polite">
        <p class="total">
          <span data-total>{money(pricing.pack, locale)}</span>
          <span class="per">{tr.common.perMonth}</span>
        </p>
        <p class="detail" data-detail>{fill(p.savings, { amount: money(sum - pricing.pack, locale) })}</p>
        <p class="detail" data-setup>{fill(p.setupPack, { amount: money(pricing.packSetup, locale) })}</p>
      </div>

      <button class="btn btn-primary" type="submit" data-submit>{p.submit}</button>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-calc]').forEach((form) => {
    const tx = JSON.parse(form.dataset.text!) as Record<'intl' | 'savings' | 'setupPack' | 'setupWeb' | 'none' | 'addMissing' | 'addMore', string>;
    const fmt = (n: number) =>
      new Intl.NumberFormat(tx.intl, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
    const fill = (s: string, amount: number) => s.replace('{amount}', fmt(amount));
    const cfg = JSON.parse(form.dataset.calc!) as {
      monthly: Record<string, number>;
      pack: number;
      setup: number;
      packSetup: number;
    };
    const total = form.querySelector<HTMLElement>('[data-total]')!;
    const detail = form.querySelector<HTMLElement>('[data-detail]')!;
    const setup = form.querySelector<HTMLElement>('[data-setup]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="plan"]')];

    const update = () => {
      const chosen = boxes.filter((b) => b.checked).map((b) => b.value);
      const sum = chosen.reduce((acc, k) => acc + (cfg.monthly[k] ?? 0), 0);
      const isPack = chosen.length === boxes.length;
      const price = isPack ? cfg.pack : sum;

      total.textContent = fmt(price);
      submit.disabled = chosen.length === 0;
      setup.hidden = !chosen.includes('web') && !isPack;
      setup.textContent = isPack ? fill(tx.setupPack, cfg.packSetup) : fill(tx.setupWeb, cfg.setup);

      if (chosen.length === 0) {
        detail.textContent = tx.none;
      } else if (isPack) {
        detail.textContent = fill(tx.savings, sum - cfg.pack);
      } else {
        const missing = boxes.length - chosen.length;
        detail.textContent = missing === 1 ? fill(tx.addMissing, cfg.pack) : tx.addMore;
      }
    };

    form.addEventListener('change', update);
    update();
  });
</script>

<style>
  .pricing {
    background: var(--bottle);
    color: var(--bottle-ink);
    padding-block: var(--space-6);
  }
  .inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-5);
    align-items: center;
  }
  h2 {
    font-size: var(--step-4);
  }
  .copy p {
    margin-top: var(--space-2);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 30rem;
  }
  .copy .note {
    font-size: var(--step--1);
    opacity: 0.8;
  }

  .calc {
    padding: var(--space-3);
    border-radius: var(--radius-l);
    background: var(--paper);
    color: var(--ink);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .opt {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1rem;
    border: 2px solid var(--line);
    border-radius: var(--radius-m);
    cursor: pointer;
    font-weight: 600;
  }
  .opt:has(input:checked) {
    border-color: var(--strong);
    background: var(--tile);
  }
  .opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .box {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 6px;
    border: 2px solid var(--muted);
    display: grid;
    place-items: center;
  }
  .opt input:checked + .box {
    background: var(--strong);
    border-color: var(--strong);
  }
  .opt input:checked + .box::after {
    content: '';
    width: 0.45rem;
    height: 0.8rem;
    border: solid var(--paper);
    border-width: 0 3px 3px 0;
    rotate: 45deg;
    translate: 0 -2px;
  }
  .opt:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .opt-price {
    color: var(--muted);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .result {
    margin-block: var(--space-3);
  }
  .total {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .total [data-total] {
    font-size: var(--step-5);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .per {
    color: var(--muted);
  }
  .detail {
    margin-top: 0.4rem;
    color: var(--muted);
  }
  .calc .btn {
    width: 100%;
  }
  .calc .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
  @media (max-width: 360px) {
    .opt {
      grid-template-columns: auto 1fr;
    }
    .opt-price {
      grid-column: 2;
    }
  }
</style>
