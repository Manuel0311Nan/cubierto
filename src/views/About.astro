---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import ContactForm from '../components/ContactForm.astro';
import { getAbout } from '../data/about';
import { site } from '../config/site';
import { breadcrumbJsonLd, personId } from '../lib/jsonld';
import { getLocale, path, t } from '../i18n';

const locale = getLocale(Astro);
const tr = t(locale);
const a = tr.about;
const { person, publishedExperience, publishedEducation, displayName } = getAbout(locale);

const sameAs = [person.linkedin, person.github].filter(Boolean);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    '@id': personId,
    name: displayName,
    jobTitle: person.role,
    worksFor: { '@id': `${site.url}/#negocio` },
    address: { '@type': 'PostalAddress', addressLocality: person.location, addressCountry: 'ES' },
    knowsAbout: tr.meta.knowsAbout,
    ...(sameAs.length ? { sameAs } : {}),
  },
};

const sections = [
  { title: a.experience, items: publishedExperience },
  { title: a.education, items: publishedEducation },
].filter((s) => s.items.length > 0);
---

<Base
  title={a.title(displayName, person.role)}
  description={a.description(displayName, person.role, person.location, site.name)}
  jsonLd={[personLd, breadcrumbJsonLd([{ name: a.crumb, path: path('sobreMi', locale) }], locale)]}
>
  <section class="head">
    <div class="wrap grid">
      <Avatar size="12rem" />
      <div>
        <h1>{a.hello(displayName.split(' ')[0])}</h1>
        <p class="lead">{person.intro}</p>
        <p class="promise">{person.promise}</p>
        {
          sameAs.length > 0 && (
            <p class="links">
              {person.linkedin && <a href={person.linkedin} rel="me noopener">LinkedIn</a>}
              {person.github && <a href={person.github} rel="me noopener">GitHub</a>}
            </p>
          )
        }
      </div>
    </div>
  </section>

  {
    sections.length > 0 && (
      <section class="section">
        <div class={`wrap cols cols-${sections.length}`}>
          {sections.map((s) => (
            <div>
              <h2>{s.title}</h2>
              <ol class="timeline">
                {s.items.map((e) => (
                  <li>
                    {e.period && <p class="period">{e.period}</p>}
                    <h3>{e.title}</h3>
                    <p>{e.detail}</p>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="section commitments" aria-labelledby="compromisos-title">
    <div class="wrap">
      <h2 id="compromisos-title">{a.promisesTitle}</h2>
      <ul class="promises">
        {
          a.promises.map((x) => (
            <li>
              <h3>{x.title}</h3>
              <p>{x.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactForm heading={a.contactHeading} />
</Base>

<style>
  .head {
    padding-block: var(--space-5);
    background: var(--tile);
  }
  .grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  h1 {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
    font-weight: 750;
  }
  .lead {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 40rem;
  }
  .promise {
    margin-top: var(--space-2);
    max-width: 40rem;
    font-weight: 600;
  }
  .links {
    display: flex;
    gap: 1.2rem;
    margin-top: var(--space-3);
    font-weight: 650;
  }
  .cols {
    display: grid;
    gap: var(--space-5);
  }
  .cols-2 {
    grid-template-columns: 1fr 1fr;
  }
  .cols-1 {
    max-width: 42rem;
  }
  h2 {
    font-size: var(--step-3);
    margin-bottom: var(--space-3);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 3px solid var(--line);
    display: grid;
    gap: var(--space-3);
  }
  .timeline li {
    position: relative;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 9px);
    top: 0.3rem;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--saffron);
    border: 3px solid var(--paper);
  }
  .period {
    font-size: var(--step--1);
    color: var(--muted);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .timeline h3 {
    margin-top: 0.2rem;
    font-size: var(--step-1);
  }
  .timeline p:last-child {
    margin-top: 0.3rem;
    color: var(--muted);
  }

  .commitments {
    padding-top: 0;
  }
  .promises {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .promises li {
    padding-top: var(--space-2);
    border-top: 4px solid var(--saffron);
  }
  .promises h3 {
    font-size: var(--step-2);
  }
  .promises p {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .grid,
    .cols-2,
    .promises {
      grid-template-columns: 1fr;
    }
  }
</style>
