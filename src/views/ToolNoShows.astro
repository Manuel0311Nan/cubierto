---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { getTools } from '../data/herramientas';
import { getServices } from '../data/services';
import { pricing } from '../config/site';
import { breadcrumbJsonLd } from '../lib/jsonld';
import { getLocale, localeInfo, path, t as dict } from '../i18n';

const locale = getLocale(Astro);
const tr = dict(locale);
const n = tr.noShows;
const { tools, noShowCalc: t } = getTools(locale);
const services = getServices(locale);
const tool = tools.find((x) => x.route === 'calculadora')!;
const fields = Object.entries(t.fields);
const jsonLd = [
  breadcrumbJsonLd(
    [
      { name: tr.tools.crumb, path: path('herramientas', locale) },
      { name: tool.name, path: path('calculadora', locale) },
    ],
    locale,
  ),
];
const text = JSON.stringify({ intl: localeInfo[locale].intl, feeOne: n.feeOne, feeMany: n.feeMany });
---

<Base title={tool.seoTitle} description={tool.seoDescription} jsonLd={jsonLd}>
  <section class="section">
    <div class="wrap">
      <nav class="crumbs" aria-label={tr.common.crumbs}>
        <a href={path('home', locale)}>{tr.common.home}</a> <span aria-hidden="true">/</span> <a href={path('herramientas', locale)}>{tr.tools.crumb}</a>
      </nav>
      <h1>{tool.h1}</h1>
      <p class="lead">{tool.intro}</p>

      <div class="calc" data-noshow data-fee={pricing.monthly.reservas} data-text={text}>
        <form class="inputs" onsubmit="return false">
          {
            fields.map(([key, f]) => (
              <div class="field">
                <label for={`ns-${key}`}>{f.label}</label>
                <input id={`ns-${key}`} name={key} type="number" inputmode="decimal" value={f.value} min={f.min} max={f.max} step={f.step} />
              </div>
            ))
          }
        </form>

        <div class="result" aria-live="polite">
          <h2>{t.resultTitle}</h2>
          <noscript><p>{t.noJs}</p></noscript>
          <dl data-out hidden>
            <div>
              <dt>{n.lost}</dt>
              <dd data-k="lost">—</dd>
            </div>
            <div>
              <dt>{n.covers}</dt>
              <dd data-k="covers">—</dd>
            </div>
            <div class="big">
              <dt>{n.month}</dt>
              <dd data-k="month">—</dd>
            </div>
            <div class="big">
              <dt>{n.year}</dt>
              <dd data-k="year">—</dd>
            </div>
          </dl>
          <p class="fee" data-fee-text hidden></p>
          <p class="formula small">{n.formulaLabel} {t.formula}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section tips" aria-labelledby="tips-title">
    <div class="wrap">
      <h2 id="tips-title">{t.tipsTitle}</h2>
      <ul class="tip-grid">
        {
          t.tips.map((x) => (
            <li>
              <h3>{x.title}</h3>
              <p>{x.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="more">
        {n.moreText}{' '}
        <a href={services.reservas.path}>{n.moreLink}</a>
      </p>
    </div>
  </section>

  <ContactForm preselect="reservas" heading={services.reservas.contactHeading} />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-noshow]').forEach((calc) => {
    const out = calc.querySelector<HTMLElement>('[data-out]')!;
    const feeText = calc.querySelector<HTMLElement>('[data-fee-text]')!;
    const fee = Number(calc.dataset.fee);
    const tx = JSON.parse(calc.dataset.text!) as { intl: string; feeOne: string; feeMany: string };
    const num = (name: string) => {
      const el = calc.querySelector<HTMLInputElement>(`[name="${name}"]`)!;
      const v = Number(el.value.replace(',', '.'));
      return Number.isFinite(v) && v >= 0 ? v : 0;
    };
    const eur = (n: number) =>
      new Intl.NumberFormat(tx.intl, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
    const int = (n: number) => new Intl.NumberFormat(tx.intl, { maximumFractionDigits: 0 }).format(n);
    const set = (k: string, v: string) => (calc.querySelector<HTMLElement>(`[data-k="${k}"]`)!.textContent = v);

    const update = () => {
      const lost = num('reservations') * (Math.min(num('noShowRate'), 100) / 100);
      const covers = lost * num('partySize');
      const perCover = num('ticket');
      const month = covers * perCover;
      set('lost', int(lost));
      set('covers', int(covers));
      set('month', eur(month));
      set('year', eur(month * 12));

      const perReservation = num('partySize') * perCover;
      if (perReservation > 0 && fee > 0) {
        const needed = Math.ceil(fee / perReservation);
        feeText.textContent = (needed === 1 ? tx.feeOne : tx.feeMany).replace('{needed}', String(needed)).replace('{fee}', eur(fee));
        feeText.hidden = false;
      } else {
        feeText.hidden = true;
      }
    };

    out.hidden = false;
    calc.addEventListener('input', update);
    update();
  });
</script>

<style>
  .crumbs {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  h1 {
    font-size: var(--step-5);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 750;
    max-width: 18ch;
  }
  .lead {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
    max-width: 40rem;
  }
  .calc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-4);
    align-items: start;
  }
  .inputs {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 2px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
  }
  .field {
    display: grid;
    gap: 0.35rem;
  }
  label {
    font-weight: 650;
  }
  input {
    font: inherit;
    font-size: var(--step-1);
    font-variant-numeric: tabular-nums;
    min-height: 3rem;
    padding: 0.4rem 0.75rem;
    border: 2px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--paper);
    color: var(--ink);
    width: 100%;
  }
  .result {
    padding: var(--space-3);
    border-radius: var(--radius-m);
    background: var(--bottle);
    color: var(--bottle-ink);
  }
  .result h2 {
    font-size: var(--step-2);
  }
  dl {
    margin: var(--space-2) 0 0;
    display: grid;
    gap: var(--space-1);
  }
  dl[hidden] {
    display: none;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bottle-ink) 22%, transparent);
  }
  dd {
    margin: 0;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .big dd {
    font-size: var(--step-3);
    color: var(--saffron);
  }
  .fee {
    margin-top: var(--space-2);
    font-weight: 650;
  }
  .formula {
    margin-top: var(--space-2);
    opacity: 0.8;
  }
  .tips {
    padding-top: 0;
  }
  .tips h2 {
    font-size: var(--step-4);
  }
  .tip-grid {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .tip-grid li {
    padding-top: var(--space-2);
    border-top: 4px solid var(--saffron);
  }
  .tip-grid h3 {
    font-size: var(--step-1);
  }
  .tip-grid p {
    margin-top: 0.4rem;
    color: var(--muted);
  }
  .more {
    margin-top: var(--space-4);
    max-width: 44rem;
  }
  .more a {
    font-weight: 650;
  }
  @media (max-width: 860px) {
    .calc,
    .tip-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
