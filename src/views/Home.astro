---
import Base from '../layouts/Base.astro';
import MenuDemo from '../components/MenuDemo.astro';
import ModuleList from '../components/ModuleList.astro';
import PackConfigurator from '../components/PackConfigurator.astro';
import Process from '../components/Process.astro';
import Pilot from '../components/Pilot.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';
import { faqsFor } from '../data/faq';
import { faqJsonLd } from '../lib/jsonld';
import { getLocale, path, t } from '../i18n';

const locale = getLocale(Astro);
const tr = t(locale);
const faqs = faqsFor('home', locale);
---

<Base title={tr.home.title} jsonLd={[faqJsonLd(faqs)]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap grid">
      <div class="copy">
        <h1 id="hero-title">{tr.home.h1}</h1>
        <p class="lead">
          {tr.home.lead(site.city)}
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={path('contacto', locale)} data-umami-event="pedir-demo" data-umami-event-lugar="home">{tr.common.askDemoMyMenu}</a>
          <a class="btn btn-ghost" href="#precios">{tr.home.seePrices}</a>
        </div>
        <p class="hint">{tr.home.hint}</p>
      </div>
      <MenuDemo />
    </div>
  </section>

  <ModuleList />
  <PackConfigurator />
  <Process />
  <Pilot />
  <AboutTeaser />
  <Faq items={faqs} />
  <ContactForm />
</Base>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-6);
    overflow: hidden;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--space-4);
    align-items: center;
  }
  h1 {
    font-size: var(--step-5);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 750;
    max-width: 12ch;
  }
  .lead {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 32rem;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-4);
  }
  .hint {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 26rem;
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    h1 {
      max-width: 16ch;
    }
    .hero {
      padding-top: var(--space-4);
    }
  }
</style>
