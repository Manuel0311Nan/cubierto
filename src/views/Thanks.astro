---
// Destino del formulario cuando se envía sin JavaScript (src/pages/api/contacto.ts).
import Base from '../layouts/Base.astro';
import { getLocale, path, t } from '../i18n';

const locale = getLocale(Astro);
const x = t(locale).thanks;
---

<Base title={x.title} noindex>
  <section class="section">
    <div class="wrap prose">
      <h1>{x.title}</h1>
      <p>{x.text}</p>
      <p><a class="btn btn-primary" href={path('home', locale)}>{x.back}</a></p>
    </div>
  </section>
</Base>

<style>
  h1 { font-size: var(--step-4); margin-bottom: var(--space-2); }
</style>
