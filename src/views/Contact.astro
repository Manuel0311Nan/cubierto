---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';
import { breadcrumbJsonLd } from '../lib/jsonld';
import { getLocale, path, t } from '../i18n';

const locale = getLocale(Astro);
const c = t(locale).contact;
---

<Base
  title={c.pageTitle}
  description={c.pageDescription(site.city)}
  jsonLd={[breadcrumbJsonLd([{ name: c.pageCrumb, path: path('contacto', locale) }], locale)]}
>
  <div class="spacer"></div>
  <ContactForm heading={c.pageHeading} level="h1" />
</Base>

<style>
  .spacer {
    height: var(--space-2);
  }
</style>
