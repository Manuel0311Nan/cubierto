---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { modules } from '../../data/modules';
import { breadcrumbJsonLd } from '../../lib/jsonld';

const guias = (await getCollection('guias', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.updated ?? b.data.published).getTime() - (a.data.updated ?? a.data.published).getTime(),
);
const moduleName = (key: string) => modules.find((m) => m.key === key)?.name ?? '';
---

<Base
  title="Guías para bares y restaurantes"
  description="Guías prácticas para dueños de bares y restaurantes: alérgenos en la carta, reservas, webs y cómo aparecer en Google. Con fuentes y sin rodeos."
  jsonLd={[breadcrumbJsonLd([{ name: 'Guías', path: '/guias/' }])]}
>
  <section class="section">
    <div class="wrap">
      <nav class="crumbs" aria-label="Estás en">
        <a href="/">Inicio</a> <span aria-hidden="true">/</span> <span aria-current="page">Guías</span>
      </nav>
      <h1>Guías para bares y restaurantes</h1>
      <p class="lead">Respuestas claras a las dudas que salen al montar la carta, las reservas o la web de tu local.</p>

      <ul class="list">
        {
          guias.map((g) => (
            <li>
              <a class="item" href={`/guias/${g.id}/`}>
                <span class="tag">{moduleName(g.data.service)}</span>
                <h2>{g.data.title}</h2>
                <p>{g.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  h1 {
    font-size: var(--step-5);
    line-height: 1.04;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }
  .lead {
    margin-top: var(--space-2);
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 38rem;
  }
  .list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    max-width: 48rem;
  }
  .item {
    display: grid;
    gap: 0.4rem;
    padding: var(--space-3);
    border-radius: var(--radius-m);
    border: 2px solid var(--line);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
  }
  .item:hover {
    border-color: var(--strong);
  }
  .tag {
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--strong);
  }
  .item h2 {
    font-size: var(--step-2);
  }
  .item p {
    color: var(--muted);
  }
</style>
