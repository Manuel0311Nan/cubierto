---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ModuleIcon from '../../components/ModuleIcon.astro';
import ContactForm from '../../components/ContactForm.astro';
import { modules } from '../../data/modules';
import { services } from '../../data/services';
import { displayName } from '../../data/about';
import { pricing, formatEuros } from '../../config/site';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/jsonld';

export async function getStaticPaths() {
  const guias = await getCollection('guias', ({ data }) => !data.draft);
  return guias.map((guia) => ({ params: { id: guia.id }, props: { guia } }));
}

const { guia } = Astro.props;
const { Content } = await render(guia);
const d = guia.data;
const path = `/guias/${guia.id}/`;
const service = services[d.service];
const mod = modules.find((m) => m.key === d.service)!;
const fmt = (date: Date) => new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' }).format(date);

const jsonLd = [
  articleJsonLd({ title: d.title, description: d.description, path, published: d.published, updated: d.updated, author: displayName }),
  breadcrumbJsonLd([
    { name: 'Guías', path: '/guias/' },
    { name: d.title, path },
  ]),
];
---

<Base title={d.seoTitle ?? d.title} description={d.description} jsonLd={jsonLd}>
  <article class="section">
    <div class="wrap">
      <nav class="crumbs" aria-label="Estás en">
        <a href="/">Inicio</a> <span aria-hidden="true">/</span> <a href="/guias/">Guías</a>
      </nav>
      <div class="prose">
        <h1>{d.title}</h1>
        <p class="meta">
          Por <a href="/sobre-mi/">{displayName}</a> ·
          {d.updated ? <>Actualizada el <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></> : <time datetime={d.published.toISOString()}>{fmt(d.published)}</time>}
        </p>
        <Content />

        <aside class="cta" aria-labelledby="cta-title">
          <span class="icon"><ModuleIcon name={d.service} size={36} /></span>
          <div>
            <h2 id="cta-title">{mod.name} para tu local</h2>
            <p>{service.intro}</p>
            <p class="price">Desde {formatEuros(pricing.monthly[d.service])} al mes, sin permanencia.</p>
            <a class="btn btn-primary" href={service.path}>Ver cómo funciona</a>
          </div>
        </aside>

        <section class="sources" aria-labelledby="fuentes-title">
          <h2 id="fuentes-title">Fuentes</h2>
          <ul>
            {d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.name}</a></li>)}
          </ul>
        </section>
      </div>
    </div>
  </article>

  <ContactForm preselect={d.service} heading={service.contactHeading} />
</Base>

<style>
  .crumbs {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  h1 {
    font-size: var(--step-4);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .meta {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--step--1);
  }
  .cta {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    margin-top: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--radius-l);
    background: var(--bottle);
    color: var(--bottle-ink);
  }
  .cta .icon {
    color: var(--saffron);
    flex: none;
  }
  .cta h2 {
    margin-top: 0;
    font-size: var(--step-2);
  }
  .cta p {
    margin: var(--space-1) 0 0;
    opacity: 0.9;
  }
  .cta .price {
    font-weight: 650;
    opacity: 1;
  }
  .cta .btn {
    margin-top: var(--space-2);
  }
  .sources ul {
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .cta {
      flex-direction: column;
    }
  }
</style>
