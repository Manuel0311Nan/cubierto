---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" noindex>
  <section class="section">
    <div class="wrap prose">
      <h1>Esta página no existe</h1>
      <p>Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      <p class="links">
        <a class="btn btn-primary" href="/">Ir al inicio</a>
        <a class="btn btn-ghost" href="/contacto/">Escribirme</a>
      </p>
    </div>
  </section>
</Base>

<style>
  h1 { font-size: var(--step-4); margin-bottom: var(--space-2); }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
