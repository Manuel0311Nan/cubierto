---
import ServicePage from '../layouts/ServicePage.astro';
---

<ServicePage service="carta">
  <section slot="demo" class="section example" aria-labelledby="ejemplo-title">
    <div class="wrap box">
      <img src="/qr/carta-ejemplo.svg" width="132" height="132" alt="Código QR de la carta de ejemplo" loading="lazy" />
      <div>
        <h2 id="ejemplo-title">Prueba una carta de ejemplo en tu móvil</h2>
        <p>Escanea el código o abre la carta de Casa Brezo, un restaurante inventado: menú del día, alérgenos en cada plato, filtro para ocultar platos y un plato agotado.</p>
        <p class="links">
          <a class="btn btn-ghost" href="/carta-digital-qr/ejemplo/">Ver la carta de ejemplo</a>
          <a href="/herramientas/tabla-alergenos/">Tabla de alérgenos para imprimir</a>
          <a href="/herramientas/generador-qr/">Generador de QR gratis</a>
        </p>
      </div>
    </div>
  </section>
</ServicePage>

<style>
  .example {
    padding-top: 0;
  }
  .box {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  .box > div {
    padding: var(--space-3);
    border-radius: var(--radius-l);
    background: var(--tile);
    flex: 1;
  }
  img {
    flex: none;
    border-radius: var(--radius-s);
  }
  h2 {
    font-size: var(--step-3);
  }
  p {
    margin-top: var(--space-1);
    max-width: 44rem;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-weight: 650;
  }
  @media (max-width: 720px) {
    img {
      display: none;
    }
  }
</style>
