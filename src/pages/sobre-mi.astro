---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import ContactForm from '../components/ContactForm.astro';
import { person, publishedExperience, publishedEducation, displayName } from '../data/about';
import { site } from '../config/site';
import { breadcrumbJsonLd } from '../lib/jsonld';

const sameAs = [person.linkedin, person.github].filter(Boolean);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: displayName,
    jobTitle: person.role,
    worksFor: { '@id': `${site.url}/#negocio` },
    address: { '@type': 'PostalAddress', addressLocality: person.location, addressCountry: 'ES' },
    knowsAbout: ['Páginas web para restaurantes', 'Carta digital con QR', 'Reservas online para restaurantes'],
    ...(sameAs.length ? { sameAs } : {}),
  },
};

const sections = [
  { title: 'Experiencia', items: publishedExperience },
  { title: 'Formación', items: publishedEducation },
].filter((s) => s.items.length > 0);
---

<Base
  title="Sobre mí"
  description={`${displayName}, ${person.role.toLowerCase()} en ${person.location}. Quién está detrás de ${site.name} y cómo trabajo con bares y restaurantes.`}
  jsonLd={[personLd, breadcrumbJsonLd([{ name: 'Sobre mí', path: '/sobre-mi/' }])]}
>
  <section class="head">
    <div class="wrap grid">
      <Avatar size="12rem" />
      <div>
        <h1>Hola, soy {displayName.split(' ')[0]}</h1>
        <p class="lead">{person.intro}</p>
        <p class="promise">{person.promise}</p>
        {
          sameAs.length > 0 && (
            <p class="links">
              {person.linkedin && <a href={person.linkedin} rel="me noopener">LinkedIn</a>}
              {person.github && <a href={person.github} rel="me noopener">GitHub</a>}
            </p>
          )
        }
      </div>
    </div>
  </section>

  {
    sections.length > 0 && (
      <section class="section">
        <div class={`wrap cols cols-${sections.length}`}>
          {sections.map((s) => (
            <div>
              <h2>{s.title}</h2>
              <ol class="timeline">
                {s.items.map((e) => (
                  <li>
                    {e.period && <p class="period">{e.period}</p>}
                    <h3>{e.title}</h3>
                    <p>{e.detail}</p>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="section commitments" aria-labelledby="compromisos-title">
    <div class="wrap">
      <h2 id="compromisos-title">Lo que te puedo prometer</h2>
      <ul class="promises">
        <li>
          <h3>Hablas siempre conmigo</h3>
          <p>Sin centralitas ni tickets. Si algo falla en mitad del servicio, me llamas y lo miro.</p>
        </li>
        <li>
          <h3>Sin permanencia</h3>
          <p>Te quedas porque te sirve, no por un contrato. Puedes dar de baja cualquier módulo cuando quieras.</p>
        </li>
        <li>
          <h3>Tus datos son tuyos</h3>
          <p>Los datos de tu local y de tus clientes se guardan en servidores de la Unión Europea, y te los llevas si te vas.</p>
        </li>
      </ul>
    </div>
  </section>

  <ContactForm heading="¿Hablamos de tu local?" />
</Base>

<style>
  .head {
    padding-block: var(--space-5);
    background: var(--tile);
  }
  .grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  h1 {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
    font-weight: 750;
  }
  .lead {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 40rem;
  }
  .promise {
    margin-top: var(--space-2);
    max-width: 40rem;
    font-weight: 600;
  }
  .links {
    display: flex;
    gap: 1.2rem;
    margin-top: var(--space-3);
    font-weight: 650;
  }
  .cols {
    display: grid;
    gap: var(--space-5);
  }
  .cols-2 {
    grid-template-columns: 1fr 1fr;
  }
  .cols-1 {
    max-width: 42rem;
  }
  h2 {
    font-size: var(--step-3);
    margin-bottom: var(--space-3);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 3px solid var(--line);
    display: grid;
    gap: var(--space-3);
  }
  .timeline li {
    position: relative;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 9px);
    top: 0.3rem;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--saffron);
    border: 3px solid var(--paper);
  }
  .period {
    font-size: var(--step--1);
    color: var(--muted);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .timeline h3 {
    margin-top: 0.2rem;
    font-size: var(--step-1);
  }
  .timeline p:last-child {
    margin-top: 0.3rem;
    color: var(--muted);
  }

  .commitments {
    padding-top: 0;
  }
  .promises {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .promises li {
    padding-top: var(--space-2);
    border-top: 4px solid var(--saffron);
  }
  .promises h3 {
    font-size: var(--step-2);
  }
  .promises p {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .grid,
    .cols-2,
    .promises {
      grid-template-columns: 1fr;
    }
  }
</style>
