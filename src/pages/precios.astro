---
import Base from '../layouts/Base.astro';
import ModuleIcon from '../components/ModuleIcon.astro';
import PackConfigurator from '../components/PackConfigurator.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import { modules } from '../data/modules';
import { services } from '../data/services';
import { faqsFor } from '../data/faq';
import { pricing, formatEuros } from '../config/site';
import { faqJsonLd, breadcrumbJsonLd } from '../lib/jsonld';

const faqs = faqsFor('precios');
const sum = Object.values(pricing.monthly).reduce((a, b) => a + b, 0);
const cheapest = Math.min(...Object.values(pricing.monthly));
---

<Base
  title="Precios de carta QR, reservas y web"
  description={`Precios claros para tu bar o restaurante: carta QR desde ${formatEuros(cheapest)} al mes, los tres módulos por ${formatEuros(pricing.pack)}. Sin permanencia ni comisiones.`}
  jsonLd={[breadcrumbJsonLd([{ name: 'Precios', path: '/precios/' }]), faqJsonLd(faqs)]}
>
  <section class="intro">
    <div class="wrap">
      <nav class="crumbs" aria-label="Estás en">
        <a href="/">Inicio</a> <span aria-hidden="true">/</span> <span aria-current="page">Precios</span>
      </nav>
      <h1>Precios de carta QR, reservas y web para restaurantes</h1>
      <p class="lead">
        Una cuota al mes por cada módulo que uses, sin permanencia y sin comisión por comensal. Los tres juntos cuestan {formatEuros(pricing.pack)} al mes en lugar de {formatEuros(sum)}.
      </p>

      <ul class="cards">
        {
          modules.map((m) => {
            const s = services[m.key];
            return (
              <li class="card">
                <span class="icon"><ModuleIcon name={m.key} size={32} /></span>
                <h2>{m.name}</h2>
                <p class="amount">
                  {formatEuros(pricing.monthly[m.key])}
                  <span> al mes</span>
                </p>
                {m.key === 'web' && <p class="setup">+ alta de {formatEuros(pricing.webSetup)} IVA incluido, pago único</p>}
                <ul class="included">
                  {s.included.map((i) => <li>{i}</li>)}
                </ul>
                <a class="more" href={s.path}>Ver {m.name.charAt(0).toLowerCase() + m.name.slice(1)}</a>
              </li>
            );
          })
        }
      </ul>
      <p class="pack-note">
        <strong>Pack completo:</strong> los tres módulos por {formatEuros(pricing.pack)} al mes y un alta única de {formatEuros(pricing.packSetup)} IVA incluido, con la web y el primer mes incluidos.
      </p>
      <p class="small muted vat">{pricing.vatNote}</p>
    </div>
  </section>

  <PackConfigurator />
  <Faq items={faqs} />
  <ContactForm heading="¿Te preparo un presupuesto para tu local?" />
</Base>

<style>
  .pack-note {
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-left: 4px solid var(--saffron);
    background: var(--tile);
    max-width: 48rem;
  }
  .intro {
    padding-block: var(--space-4) var(--space-5);
  }
  .crumbs {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  h1 {
    font-size: var(--step-5);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 750;
    max-width: 18ch;
  }
  .lead {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
    max-width: 40rem;
  }
  .cards {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: var(--space-3);
    border-radius: var(--radius-l);
    background: var(--surface);
    border: 2px solid var(--line);
  }
  .card .icon {
    color: var(--strong);
  }
  .card h2 {
    font-size: var(--step-2);
  }
  .amount {
    font-size: var(--step-4);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .amount span {
    margin-left: 0.35rem;
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }
  .setup {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .included {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    flex: 1;
  }
  .more {
    margin-top: 0.6rem;
    font-weight: 650;
  }
  .vat {
    margin-top: var(--space-2);
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
